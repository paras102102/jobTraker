# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Environment
ENVIRONMENT=development

# Postgres Database (Docker Compose)
POSTGRES_USER=jobtrackr_user
POSTGRES_PASSWORD=jobtrackr_password
POSTGRES_DB=jobtrackr_db

# Backend Database URL
DATABASE_URL=postgresql://jobtrackr_user:jobtrackr_password@localhost:5432/jobtrackr_db
TEST_DATABASE_URL=postgresql://jobtrackr_user:jobtrackr_password@localhost:5432/jobtrackr_test_db

# Security & JWT Tokens
SECRET_KEY=dev_insecure_secret_key_change_in_production_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Admin Seeding
ADMIN_EMAIL=admin@jobtrackr.io
ADMIN_PASSWORD=Admin@12345

# Frontend & CORS
FRONTEND_URL=http://localhost:3000
