# Environment
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql://jobtrackr_user:jobtrackr_password@db:5432/jobtrackr_db
TEST_DATABASE_URL=postgresql://jobtrackr_user:jobtrackr_password@db:5432/jobtrackr_test_db

# Security & Tokens
SECRET_KEY=dev_insecure_secret_key_change_in_production_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Admin Seeding
ADMIN_EMAIL=admin@jobtrackr.io
ADMIN_PASSWORD=Admin@12345

# CORS
FRONTEND_URL=http://localhost:3000
